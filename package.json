{
  "name": "natsclient",
  "version": "0.1.0",
  "description": "Web-based NATS message inspector — like the Chrome network tab for NATS",
  "bin": {
    "natsclient": "./bin/natsclient.js"
  },
  "files": [
    "dist-client/",
    "dist-server/",
    "bin/"
  ],
  "scripts": {
    "build:client": "vite build",
    "build:server": "tsc --project tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "dev:server": "tsx watch src/server/index.ts -- --no-open",
    "dev:client": "vite",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "get-port": "^7.1.0",
    "nats": "^2.18.0",
    "open": "^10.1.0",
    "ws": "^8.16.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/ws": "^8.5.10",
    "@types/yargs": "^17.0.32",
    "@vitejs/plugin-react": "^4.2.1",
    "ag-grid-community": "^31.0.3",
    "ag-grid-react": "^31.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  },
  "engines": {
    "node": ">=18"
  }
}
